# Copie para backend/.env e preencha. NUNCA comite o .env (ja esta no .gitignore).

# --- LiveKit (servidor de voz) ---
# Pegue em https://cloud.livekit.io -> Settings -> Keys, ou no livekit.yaml do seu servidor.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase ---
# Usados para validar o login do usuario e checar se ele e membro do servidor.
# A anon/publishable key e a MESMA que o frontend usa (e publica por design).
SUPABASE_URL=https://jdmoprahepzbpmuttywd.supabase.co
SUPABASE_ANON_KEY=

# --- Rede ---
PORT=3001
# Origens liberadas no CORS, separadas por virgula. Em producao liste o dominio real.
# Deixar vazio libera qualquer origem — so use assim em desenvolvimento local.
# ATENCAO: entre subir o nginx e rodar o certbot o site responde em http://, e o
# navegador manda a origem http. Inclua as duas enquanto testa, e tire as http://
# depois que o HTTPS estiver de pe.
CORS_ORIGINS=https://convorax.space,https://www.convorax.space,http://convorax.space

# Validade do token da call: "6h", "30m" ou um numero puro de segundos (21600).
TOKEN_TTL=6h

# Endereco de escuta. Mantenha em loopback: quem fala com o backend e o nginx,
# da propria maquina. Mudar para 0.0.0.0 expoe a porta na internet.
HOST=127.0.0.1

# --- Opcional: aviso de bug no Telegram ---
# Se ficarem vazios, o relato so vai para o log do servico (journalctl -u convorax-api).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
